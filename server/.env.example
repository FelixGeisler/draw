# Optional: enables AI features (task breakdown, backward planning).
# Get a key at https://platform.claude.com/ — the app works fully without it.
ANTHROPIC_API_KEY=
# API_PORT, deliberately not PORT — dev tooling injects PORT.
API_PORT=3001
# Listener address — production mode (npm start) only; npm run dev always
# binds loopback. Default 127.0.0.1 = not reachable from the LAN. Set
# HOST=0.0.0.0 for the self-hosted deployment (#189, ADR-49) — and set
# DRAW_PASSWORD below whenever you do.
HOST=127.0.0.1
# Optional password gate for LAN exposure (#190, ADR-50) — production mode
# only. Unset/empty = no login anywhere. Set: browser sessions last 30 days
# (signed cookie via a login page); the MCP adapter reads this same variable
# and authenticates with it automatically. Plain HTTP — for TLS, put a
# reverse proxy in front.
DRAW_PASSWORD=
# Set ONLY if a reverse proxy fronts the app (the TLS setup above), so the
# login rate limiter sees the real client IP instead of the proxy. Use
# "loopback" for a same-host proxy, or a hop count like "1". Leaving this
# unset behind a proxy collapses per-IP throttling. Avoid "true" (a client
# could then spoof X-Forwarded-For). Production mode only.
TRUST_PROXY=
# Scheduled automatic backups (#194, ADR-52) — production mode only. The server
# writes a backup zip into DATA_DIR/backups/ every BACKUP_INTERVAL_HOURS and
# keeps the newest BACKUP_RETENTION archives (older ones are pruned). Unset or
# 0 = disabled (the default; nothing runs). No cron needed — the timer lives in
# the server process, for the headless Pi. Restore = the existing
# POST /api/backup/import (or the Settings "Restore" flow).
BACKUP_INTERVAL_HOURS=
BACKUP_RETENTION=7
