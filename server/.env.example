# Optional: enables AI features (task breakdown, backward planning).
# Get a key at https://platform.claude.com/ — the app works fully without it.
ANTHROPIC_API_KEY=
# API_PORT, deliberately not PORT — dev tooling injects PORT.
API_PORT=3001
# Listener address — production mode (npm start) only; npm run dev always
# binds loopback. Default 127.0.0.1 = not reachable from the LAN. Set
# HOST=0.0.0.0 for the self-hosted deployment (#189, ADR-49) — Draw has no
# auth, so only on a trusted network.
HOST=127.0.0.1
